# palantir 환경변수 템플릿 — 실제 값은 절대 커밋하지 말 것 (.env는 .gitignore 처리됨)
# 사용법: cp .env.example .env  후 실제 값 채우기

# ── Confluence ──────────────────────────────
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PARENT_ID=
CONFLUENCE_USER=
CONFLUENCE_TOKEN=
CONFLUENCE_REGISTRY_PAGE_ID=

# ── Bitbucket ───────────────────────────────
BITBUCKET_TOKEN=
CUSTOMER_BB_TOKEN=
AUDIT_RESULT_REPO_URL=

# ── Fortify SSC (SCA) ───────────────────────
SSC_BASE_URL=
SSC_TOKEN=
SSC_USERNAME=
SSC_PASSWORD=

# ── NVD (CVE 조회) ──────────────────────────
NVD_API_KEY=

# ── Jira ────────────────────────────────────
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=
JIRA_REMEDIATION_DATE_FIELD_ID=
JIRA_GATEWAY_URL=
JIRA_TOKEN_REMEDIATION=
